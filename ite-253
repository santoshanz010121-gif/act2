```html
<!DOCTYPE html>
<html>
<head>
    <title>Student Management System</title>
</head>

<body>

    <h2>Student Management System</h2>

    <label>Student ID:</label>
    <input type="text" id="studentId">
    <br><br>

    <label>Student Name:</label>
    <input type="text" id="studentName">
    <br><br>

    <label>Course:</label>
    <input type="text" id="studentCourse">
    <br><br>

    <input type="hidden" id="editIndex" value="-1">

    <button onclick="saveStudent()">Save Student</button>
    <button onclick="clearForm()">Clear</button>

    <br><br>

    <label>Search:</label>
    <input type="text" id="searchInput">

    <button onclick="searchStudent()">Search</button>
    <button onclick="displayStudents()">Show All</button>
    <button onclick="sortStudentsByName()">Sort by Name</button>

    <br><br>

    <table border="1" cellpadding="8">
        <thead>
            <tr>
                <th>Student ID</th>
                <th>Name</th>
                <th>Course</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody id="studentTable"></tbody>
    </table>

    <p id="studentTotal">Total Students: 0</p>

    <script>

        let students = [];

        function saveStudent() {

            let id = document.getElementById("studentId").value.trim();
            let name = document.getElementById("studentName").value.trim();
            let course = document.getElementById("studentCourse").value.trim();
            let editIndex = parseInt(document.getElementById("editIndex").value);

            if (id == "" || name == "" || course == "") {
                alert("Please complete all fields.");
                return;
            }

            for (let index = 0; index < students.length; index++) {

                if (index != editIndex) {

                    if (students[index].id.toLowerCase() == id.toLowerCase()) {
                        alert("Student ID already exists.");
                        return;
                    }

                    if (students[index].name.toLowerCase() == name.toLowerCase()) {
                        alert("Student name already exists.");
                        return;
                    }
                }
            }

            if (editIndex == -1) {

                let newStudent = {
                    id: id,
                    name: name,
                    course: course
                };

                students[students.length] = newStudent;

                alert("Student added successfully.");

            } else {

                students[editIndex].id = id;
                students[editIndex].name = name;
                students[editIndex].course = course;

                alert("Student updated successfully.");
            }

            clearForm();
            displayStudents();
        }


        function displayStudents() {

            let table = document.getElementById("studentTable");

            table.innerHTML = "";

            if (students.length == 0) {

                table.innerHTML =
                    "<tr>" +
                    "<td colspan='4'>No student records found.</td>" +
                    "</tr>";

                document.getElementById("studentTotal").innerHTML =
                    "Total Students: 0";

                return;
            }

            for (let index = 0; index < students.length; index++) {

                table.innerHTML +=
                    "<tr>" +
                    "<td>" + students[index].id + "</td>" +
                    "<td>" + students[index].name + "</td>" +
                    "<td>" + students[index].course + "</td>" +
                    "<td>" +
                    "<button onclick='editStudent(" + index + ")'>Edit</button> " +
                    "<button onclick='deleteStudent(" + index + ")'>Delete</button>" +
                    "</td>" +
                    "</tr>";
            }

            document.getElementById("studentTotal").innerHTML =
                "Total Students: " + students.length;
        }


        function editStudent(index) {

            document.getElementById("studentId").value =
                students[index].id;

            document.getElementById("studentName").value =
                students[index].name;

            document.getElementById("studentCourse").value =
                students[index].course;

            document.getElementById("editIndex").value = index;
        }


        function deleteStudent(index) {

            let answer = confirm(
                "Are you sure you want to delete this student?"
            );

            if (answer == false) {
                return;
            }

            for (
                let position = index;
                position < students.length - 1;
                position++
            ) {
                students[position] = students[position + 1];
            }

            students.length = students.length - 1;

            clearForm();
            displayStudents();

            alert("Student deleted successfully.");
        }


        function clearForm() {

            document.getElementById("studentId").value = "";
            document.getElementById("studentName").value = "";
            document.getElementById("studentCourse").value = "";
            document.getElementById("editIndex").value = "-1";
        }


        function searchStudent() {

            let searchValue =
                document.getElementById("searchInput").value
                .trim()
                .toLowerCase();

            let table = document.getElementById("studentTable");

            table.innerHTML = "";

            let found = false;

            for (let index = 0; index < students.length; index++) {

                let studentId = students[index].id.toLowerCase();
                let studentName = students[index].name.toLowerCase();

                if (
                    studentId.indexOf(searchValue) != -1 ||
                    studentName.indexOf(searchValue) != -1
                ) {

                    table.innerHTML +=
                        "<tr>" +
                        "<td>" + students[index].id + "</td>" +
                        "<td>" + students[index].name + "</td>" +
                        "<td>" + students[index].course + "</td>" +
                        "<td>" +
                        "<button onclick='editStudent(" + index + ")'>Edit</button> " +
                        "<button onclick='deleteStudent(" + index + ")'>Delete</button>" +
                        "</td>" +
                        "</tr>";

                    found = true;
                }
            }

            if (found == false) {

                table.innerHTML =
                    "<tr>" +
                    "<td colspan='4'>No matching student found.</td>" +
                    "</tr>";
            }
        }


        function sortStudentsByName() {

            for (let first = 0; first < students.length - 1; first++) {

                for (
                    let second = first + 1;
                    second < students.length;
                    second++
                ) {

                    if (
                        students[first].name.toLowerCase() >
                        students[second].name.toLowerCase()
                    ) {

                        let temporary = students[first];

                        students[first] = students[second];

                        students[second] = temporary;
                    }
                }
            }

            displayStudents();
        }


        displayStudents();

    </script>

</body>
</html>
